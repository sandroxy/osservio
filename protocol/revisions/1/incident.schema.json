            },
            "isTruncated": {
              "const": false
            }
          },
          "required": [
            "type",
            "value",
            "isTruncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "unsupported"
            },
            "value": {
              "type": "null"
            },
            "isTruncated": {
              "const": false
            }
          },
          "required": [
            "type",
            "value",
            "isTruncated"
          ],
          "additionalProperties": false
        }
      ]
    },
