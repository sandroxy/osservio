{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osservio:incident:1",
  "title": "Osservio incident metadata revision 1",
  "type": "object",
  "properties": {
    "format": {
      "const": "osservio.incident"
    },
    "revision": {
      "const": 1
    },
    "payloadFile": {
      "const": "payloads.json"
    },
    "incident": {
      "$ref": "#/$defs/incident"
    }
  },
  "required": [
    "format",
    "revision",
    "payloadFile",
    "incident"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "bodyID": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.(request|response)(?![\\s\\S])"
    },
    "int64": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})(?![\\s\\S])",
      "format": "int64"
    },
    "uint63": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})(?![\\s\\S])",
      "format": "uint63"
    },
    "positive64": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}(?![\\s\\S])",
      "format": "positive64"
    },
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])",
      "format": "uint64"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}(?![\\s\\S])"
    },
    "url": {
      "type": "string",
      "maxLength": 4128,
      "format": "utf8-4128",
      "pattern": "^(\\[unavailable\\]|(?:https?|wss?)://[^?#]+(?:\\?\\[redacted\\])?)(?![\\s\\S])"
    },
    "note": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4096,
          "format": "utf8-4096"
        },
        "isPrivate": {
          "type": "boolean"
        },
        "isTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "isPrivate",
        "isTruncated"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "isPrivate": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "const": "[private]"
              },
              "isTruncated": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "header": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}(?![\\s\\S])"
        },
        "value": {
          "type": "string",
          "maxLength": 512,
          "format": "utf8-512"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "authorization",
                  "proxy-authorization",
                  "cookie",
                  "set-cookie",
                  "x-api-key"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "[redacted]"
              }
            }
          }
        }
      ]
    },
    "environmentValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "minLength": 1,
              "type": "string",
              "maxLength": 256,
              "format": "utf8-256"
            },
            "isTruncated": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value",
            "isTruncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "$ref": "#/$defs/uint63"
            },
            "isTruncated": {
              "const": false
            }
          },
          "required": [
            "type",
            "value",
            "isTruncated"
          ],
          "additionalProperties": false
        },
        {
