<resources>
    <style name="OsservioScreenLight" parent="OsservioInspectorDialogLight">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="OsservioScreenDark" parent="OsservioInspectorDialogDark">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="OsservioInspectorLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/osservio_accent</item>
        <item name="android:colorBackground">@color/osservio_canvas</item>
        <item name="android:textColorPrimary">@color/osservio_primary</item>
        <item name="android:textColorSecondary">@color/osservio_secondary</item>
        <item name="android:windowBackground">@color/osservio_canvas</item>
        <item name="android:alertDialogTheme">@style/OsservioInspectorDialogLight</item>
        <item name="android:buttonStyle">@style/OsservioInspectorButton</item>
    </style>
    <style name="OsservioInspectorDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/osservio_accent</item>
        <item name="android:colorBackground">@color/osservio_canvas</item>
        <item name="android:textColorPrimary">@color/osservio_primary</item>
        <item name="android:textColorSecondary">@color/osservio_secondary</item>
        <item name="android:windowBackground">@color/osservio_canvas</item>
        <item name="android:alertDialogTheme">@style/OsservioInspectorDialogDark</item>
        <item name="android:buttonStyle">@style/OsservioInspectorButton</item>
    </style>
    <style name="OsservioInspectorDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/osservio_accent</item>
        <item name="android:colorBackground">@color/osservio_surface</item>
        <item name="android:textColorPrimary">@color/osservio_primary</item>
        <item name="android:textColorSecondary">@color/osservio_secondary</item>
    </style>
    <style name="OsservioInspectorDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/osservio_accent</item>
        <item name="android:colorBackground">@color/osservio_surface</item>
        <item name="android:textColorPrimary">@color/osservio_primary</item>
        <item name="android:textColorSecondary">@color/osservio_secondary</item>
    </style>
    <style name="OsservioInspectorButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/osservio_accent</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
